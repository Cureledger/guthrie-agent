# Copy to .env for local dev. In Railway, set these in the service Variables UI.

# --- LLM (set at least one) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- SQL plugin (Postgres) — required for production on Railway ---
# Add a Railway Postgres plugin and reference its connection string, or set manually:
# POSTGRES_URL=postgresql://user:pass@host:5432/railway

# --- Server (local defaults; on Railway, PORT is injected automatically) ---
# SERVER_PORT=3000

# --- Optional integrations ---
# DISCORD_API_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TWITTER_EMAIL=
# TWITTER_PASSWORD=
# TWITTER_USERNAME=

# NODE_ENV=production
# LOG_LEVEL=info
