# build/ holds the SCRIPTS the index job runs (fetch_corpus.py, build_index.py,
# ...), so it is tracked; only the corpus it generates is ignored.

# large binaries — regenerable or artifact-backed, not for git
*.tar.gz
build/raw/
pku_index/*.npy
pku_index/*.pkl
pku_index/*.sqlite
__pycache__/
*.pyc
.venv/
operator/output/
operator/ledger.jsonl
operator/HALT

# the index job checks the PKU Commons documents out here
/pku-commons/
